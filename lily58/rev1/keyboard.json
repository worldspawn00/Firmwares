                {"matrix": [4, 3], "x": 4.5, "y": 4.25},
                {"matrix": [4, 4], "x": 6, "y": 4.25, "h": 1.5},

                {"matrix": [9, 4], "x": 9.5, "y": 4.25, "h": 1.5},
                {"matrix": [9, 3], "x": 11, "y": 4.25},
                {"matrix": [9, 2], "x": 12, "y": 4.15},
